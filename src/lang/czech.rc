IDD_TRANSFER_SPEED DIALOGEX 16, 24, 234, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nastavit omezení rychlosti"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "Limit rychlosti", -1, 8, 8, 48, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 58, 12, 170, 1
    CONTROL "&Nepoužívat omezení rychlosti", IDC_TRANSFER_SPEED_UNLIMITED, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 16, 19, 110, 12
    CONTROL "Nastavit &omezení rychlosti:", IDC_TRANSFER_SPEED_ENABLE, "Button", BS_AUTORADIOBUTTON, 16, 32, 103, 12
    EDITTEXT IDC_TRANSFER_SPEED_VALUE, 126, 32, 34, 12, ES_AUTOHSCROLL
    COMBOBOX IDC_TRANSFER_SPEED_UNITS, 166, 32, 35, 49, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 7, 61, 221, 1
    DEFPUSHBUTTON "OK", IDOK, 33, 67, 50, 14, WS_GROUP
    PUSHBUTTON "Storno", IDCANCEL, 92, 67, 50, 14
    PUSHBUTTON "Nápověda", IDHELP, 151, 67, 50, 14
END
STRINGTABLE
BEGIN
    IDS_TRANSFER_SPEED_INVALID "Zadejte kladné celé číslo v B/s, KB/s, MB/s nebo GB/s, nejvýše 1 TB/s."
    IDS_TRANSFER_SPEED_KB "KB/s"
    IDS_TRANSFER_SPEED_MB "MB/s"
    IDS_TRANSFER_SPEED_B "B/s"
    IDS_TRANSFER_SPEED_GB "GB/s"
    IDS_TRANSFER_SPEED_HELP "Zvolte přenos bez omezení nebo zadejte kladné celé číslo a jednotku (1024 B = 1 KB). Maximum je 1 TB/s. Limit platí pro kopírovaná data včetně pojmenovaných proudů a kopií pro obnovu, pouze pro tuto dávku. Čtení při ověřování se neomezuje. Storno ponechá předchozí nastavení."
END

STRINGTABLE
BEGIN
    IDS_TRANSFER_PAUSE "&Pozastavit"
    IDS_TRANSFER_RESUME "&Pokračovat"
    IDS_TRANSFER_PAUSED "(pozastaveno)"
    IDS_TRANSFER_PAUSING "Pozastavování…"
    IDS_TRANSFER_SET_SPEED "Nastavit &omezení rychlosti…"
    IDS_TRANSFER_COPIED "Zkopírováno {copied} z {total}"
    IDS_TRANSFER_RATE ", rychlost: {rate}/s"
    IDS_TRANSFER_RATE_LIMIT ", rychlost: {rate}/s ({limit}/s)"
    IDS_TRANSFER_LEFT ", zbývá: {time}"
END

IDD_OPERATION_ERROR DIALOGEX 0, 0, 330, 139
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Chyba operace se souborem"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_ERROR_CONTEXT, 7, 7, 316, 10
    LTEXT "Zdroj:", -1, 7, 25, 36, 10
    EDITTEXT IDC_ERROR_SOURCE, 45, 22, 278, 14, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Cíl:", -1, 7, 44, 36, 10
    EDITTEXT IDC_ERROR_TARGET, 45, 41, 278, 14, ES_READONLY | ES_AUTOHSCROLL
    EDITTEXT IDC_ERROR_DETAILS, 7, 62, 316, 48, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "&Opakovat", IDC_ERROR_RETRY, 7, 118, 76, 14
    PUSHBUTTON "&Přeskočit", IDC_ERROR_SKIP, 87, 118, 76, 14
    PUSHBUTTON "Přeskočit &vše", IDC_ERROR_SKIP_ALL, 167, 118, 76, 14
    PUSHBUTTON "&Zrušit", IDCANCEL, 247, 118, 76, 14
END
STRINGTABLE
BEGIN
    IDS_ERROR_WAIT "Čekání na rozhodnutí o chybě…"
    IDS_UI_SKIPPED "Přeskočeno při provádění"
    IDS_ERROR_SOURCE "Kopírování nové položky — čtení zdroje"
    IDS_ERROR_TARGET "Kopírování nové položky — příprava nebo publikace cíle"
    IDS_ERROR_DATA "Kopírování nové položky — přenos dat"
    IDS_ERROR_POLICY "Zastavit kopírování nových položek, uchování originálů a přepisy při první chybě. Jinak se opravitelné chyby dotazují. Mazání a souhrnná synchronizace zatím vždy zastaví při první chybě."
    IDS_ERROR_SKIPPED_NOTE "Dokončeno s přeskočenými položkami; nebyly provedeny všechny plánované operace."
END

STRINGTABLE
BEGIN
    IDS_ERROR_SAVE_SOURCE "Uchování originálu — čtení originálu"
    IDS_ERROR_SAVE_TARGET "Uchování originálu — příprava kopie"
    IDS_ERROR_SAVE_DATA "Uchování originálu — přenos dat"
    IDS_ERROR_OVERWRITE_SOURCE "Přepis — čtení zdroje"
    IDS_ERROR_OVERWRITE_TARGET "Přepis — příprava nebo publikace cíle"
    IDS_ERROR_OVERWRITE_DATA "Přepis — přenos dat"
    IDS_UI_DEPENDENCY_BLOCKED "Nepřepsáno: originál neuchován"
END
