    IDS_SYNC_DELETE "Mazání (hotové / plánované)"
    IDS_SYNC_NEW_COUNTS "Nové kopie (soubory / adresáře)"
    IDS_SYNC_DELETE_COUNTS "Mazání (soubory / adresáře)"
    IDS_SYNC_REPLACED "Přepisy (hotové / plánované)"
END

