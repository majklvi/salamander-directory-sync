    PUSHBUTTON "OK", IDOK, 137, 167, 76, 14
    DEFPUSHBUTTON "Cancel", IDCANCEL, 219, 167, 74, 14
END
IDD_APPEARANCE DIALOGEX 0, 0, 306, 287
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Preferences"
FONT 8, "MS Shell Dlg"
BEGIN
