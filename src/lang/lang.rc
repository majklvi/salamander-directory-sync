    IDS_UI_COPY_CONFIRM "Confirm copies to new targets"
    IDS_UI_COPY_RESULT "New-item copy result"
    IDS_UI_SAVE_CONFIRM "Confirm saving originals"
    IDS_UI_SAVE_RESULT "Recovery result"
    IDS_UI_OVERWRITE_CONFIRM "Confirm file overwrites"
    IDS_UI_OVERWRITE_RESULT "Overwrite result"
    IDS_UI_DELETE_CONFIRM "Confirm deletion"
    IDS_UI_DELETE_RESULT "Deletion result"
    IDS_UI_HIDDEN_ATTRIBUTE "Hidden"
    IDS_UI_SYSTEM_ATTRIBUTE "System"
