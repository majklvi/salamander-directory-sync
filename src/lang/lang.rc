    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 73, 11, 226, 1
    CONTROL "Show action &labels", IDC_ACTION_LABELS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 22, 140, 12
    CONTROL "Color row text", IDC_COLOR_ROWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 22, 140, 12
