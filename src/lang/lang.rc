LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_PREVIEW DIALOGEX 0, 0, 610, 490
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Directory Synchronization"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Left folder:", -1, 8, 9, 52, 10
    EDITTEXT IDC_LEFT, 62, 6, 206, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_LEFT, 272, 6, 14, 14
    LTEXT "&Right folder:", IDC_RIGHT_LABEL, 300, 9, 52, 10
    EDITTEXT IDC_RIGHT, 354, 6, 206, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_RIGHT, 564, 6, 14, 14
    CONTROL "Profiles", IDC_PROFILE_MENU, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 588, 6, 14, 14
    LTEXT "&Masks:", -1, 8, 29, 28, 10
    EDITTEXT IDC_MASK, 38, 26, 45, 14, ES_AUTOHSCROLL
    CONTROL "Sub&folders", IDC_RECURSIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 91, 28, 69, 12
    CONTROL "By c&ontent", IDC_CONTENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 28, 80, 12
    CONTROL "&Ignore date", IDC_IGNORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 248, 28, 82, 12
    CONTROL "&Asymmetric", IDC_ASYMMETRIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 91, 41, 69, 12
    CONTROL "Panel &selection", IDC_SELECTED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 41, 80, 12
    CONTROL "&Empty folders", IDC_EMPTY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 248, 41, 82, 12
    CONTROL "E&qual", IDC_EQUAL, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 352, 26, 14, 14
    CONTROL "&Different", IDC_DIFFERENT, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 370, 26, 14, 14
    CONTROL "Si&ngle-sided", IDC_SINGLE, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 388, 26, 14, 14
    CONTROL "Left to ri&ght", IDC_TORIGHT, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 352, 46, 14, 14
    CONTROL "Rig&ht to left", IDC_TOLEFT, "Button", BS_CHECKBOX | BS_PUSHLIKE | BS_ICON | WS_TABSTOP, 370, 46, 14, 14
    DEFPUSHBUTTON "&Compare", IDC_COMPARE, 430, 26, 88, 14, WS_GROUP
    CONTROL "S&top comparison", IDC_STOP, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 518, 26, 14, 14
    PUSHBUTTON "S&ynchronize...", IDC_SYNCHRONIZE, 430, 46, 88, 14, WS_GROUP
    CONTROL "Sto&p synchronization", IDC_STOP_SYNC, "Button", BS_PUSHBUTTON | BS_ICON | WS_TABSTOP, 518, 46, 14, 14
    PUSHBUTTON "Settings...", IDC_SETTINGS, 546, 26, 56, 14
    PUSHBUTTON "Close", IDCANCEL, 546, 46, 56, 14
    CONTROL "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 70, 610, 404
    CONTROL "", IDC_STATUS, "msctls_statusbar32", SBARS_SIZEGRIP | SBARS_TOOLTIPS, 0, 474, 610, 16
END
IDD_INFORMATION DIALOGEX 0, 0, 300, 188
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Directory Synchronization"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_INFO_TABLE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 7, 286, 84
