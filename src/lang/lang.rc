    CONTROL "", 463, "Static", SS_OWNERDRAW, 129, 96, 18, 16
    LTEXT "&Skip:", -1, 159, 45, 88, 10
    PUSHBUTTON "...", 454, 251, 42, 26, 16
    CONTROL "", 464, "Static", SS_OWNERDRAW, 281, 42, 18, 16
    LTEXT "Dele&te:", -1, 159, 63, 88, 10
    PUSHBUTTON "...", 455, 251, 60, 26, 16
    CONTROL "", 465, "Static", SS_OWNERDRAW, 281, 60, 18, 16
    LTEXT "Decision / &blocked:", -1, 159, 81, 88, 10
    PUSHBUTTON "...", 456, 251, 78, 26, 16
    CONTROL "", 466, "Static", SS_OWNERDRAW, 281, 78, 18, 16
    PUSHBUTTON "Restore defa&ult colors", IDC_COLOR_RESET, 179, 102, 120, 16
    LTEXT "Columns", -1, 7, 123, 60, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 73, 127, 226, 1
    CONTROL "Left size", 520, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 136, 140, 12
    CONTROL "Left modified", 521, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 149, 140, 12
    CONTROL "Right size", 522, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 162, 140, 12
    CONTROL "Right modified", 523, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 175, 140, 12
    CONTROL "State", 524, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 136, 140, 12
    CONTROL "Reason", 525, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 149, 140, 12
    CONTROL "Error", 526, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 162, 140, 12
    CONTROL "Show side names in headers", IDC_SIDE_NAMES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 175, 140, 12
    CONTROL "Show sizes relatively", IDC_RELATIVE_SIZES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 190, 140, 12
    CONTROL "Show times relatively", IDC_RELATIVE_TIMES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 159, 190, 140, 12
    LTEXT "Other settings", -1, 7, 209, 75, 8
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 88, 213, 211, 1
    CONTROL "&Keep originals", IDC_KEEP_ORIGINALS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 225, 140, 12
    LTEXT "Rec&overy folder:", IDC_RECOVERY_LABEL, 7, 246, 76, 10
    EDITTEXT IDC_RECOVERY_ROOT, 86, 243, 195, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE_RECOVERY, 285, 243, 14, 14
    PUSHBUTTON "Stored originals...", IDC_STORED_ORIGINALS, 7, 267, 116, 14
    DEFPUSHBUTTON "OK", IDOK, 169, 267, 62, 14
    PUSHBUTTON "Cancel", IDCANCEL, 237, 267, 62, 14
END
STRINGTABLE
BEGIN
    IDS_MENU_PLAN "&Visible plan"
    IDS_PLAN_HELP_SUMMARY "Shows the visible operation plan for review; changes no files."
    IDS_PLAN_HELP_SAVE "Saves verified recovery copies of existing overwrite targets; does not overwrite or delete them."
    IDS_PLAN_HELP_COPY "Creates missing files and empty directories in the proposed direction; never replaces existing targets."
    IDS_PLAN_HELP_OVERWRITE "Replaces existing files in the proposed direction; preserves target permissions."
    IDS_PLAN_HELP_DELETE "Deletes right-only items proposed for deletion in asymmetric mode; directories must be empty."
